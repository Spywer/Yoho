<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/dialog_support_background"
    android:clipToOutline="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/support_project_title"
        android:textColor="@color/support_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/support_project_message"
        android:textColor="@color/support_text_primary"
        android:textSize="24sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/support_project_scan_hint"
        android:textColor="@color/support_text_primary"
        android:textSize="24sp"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/img_support_qr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/support_qr_description"
        android:scaleType="fitCenter"
        android:src="@drawable/qr_donate_cloudtips" />

    <TextView
        android:id="@+id/text_support_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/support_project_url"
        android:textColor="@color/support_text_primary"
        android:textSize="24sp"
        android:linksClickable="true"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_support_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/support_close"
        android:textSize="18sp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
